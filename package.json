{
  "name": "gottesdienstregie",
  "version": "0.45.1",
  "description": "Desktop-Regiesoftware für Gottesdienstpräsentationen der Philippusgemeinde.",
  "author": {
    "name": "Philippusgemeinde Ev. Freikirche",
    "email": "cmoere@users.noreply.github.com"
  },
  "desktopName": "GottesdienstRegie",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite --mode web --port 4173",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "build:web": "tsc -b && vite build --mode web --outDir dist-web",
    "start": "electron .",
    "test:unit": "vitest run",
    "test:web": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "installer": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.6",
    "@huggingface/transformers": "3.8.1",
    "bcryptjs": "^3.0.2",
    "country-flag-icons": "^1.6.20",
    "electron-updater": "^6.6.2",
    "firebase": "^12.2.1",
    "flag-icons": "^7.5.0",
    "jszip": "^3.10.1",
    "material-symbols": "^0.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "firebase-tools": "^14.27.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "de.philippusgemeinde.gottesdienstregie2",
    "productName": "GottesdienstRegie",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cmoere",
        "repo": "GottesdienstRegie",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GottesdienstRegie-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "GottesdienstRegie-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "artifactName": "GottesdienstRegie-${version}-${arch}.${ext}"
    },
    "nsis": {
      "license": "build/terms.txt",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GottesdienstRegie",
      "deleteAppDataOnUninstall": false
    }
  }
}
